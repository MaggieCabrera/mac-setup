[user]
	name = MaggieCabrera
	email = maggie.cabrera@automattic.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFU8xHHGhioGPWzuJrcJ4T2EVGzdLNuP+qVizVtzIs4q
[core]
	editor = code --wait
	excludesfile = ~/.gitignore_global
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = "code --wait --diff  "
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
